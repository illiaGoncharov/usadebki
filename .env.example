DATABASE_URL=postgres://usadebki:usadebki@localhost:5434/usadebki
# Pooled-строка Neon (Connect → Copy) — для db:migrate:neon, db:push-neon / db:sync-neon
NEON_DATABASE_URL=
ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-me
# Ключ светлой подложки CARTO. Задаётся на сервере при запуске, не в сборке браузера.
# https://carto.com/basemaps/apikey
CARTO_KEY=
# Письма на вашу почту (фидбэк, жалоба на фото, уточнения «уточнить») — https://resend.com
CONTACT_EMAIL=
RESEND_API_KEY=
# Отправитель (домен должен быть подтверждён в Resend)
# Проще для теста: только onboarding@resend.dev (письма только на почту аккаунта Resend)
RESEND_FROM=onboarding@resend.dev
# Публичный URL сайта для ссылок в письмах (на Vercel можно не задавать — возьмётся VERCEL_URL)
SITE_URL=https://usadebki-beta.vercel.app
