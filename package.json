{
  "name": "usadebki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:neon": "node --env-file=.env --import tsx scripts/db-migrate-neon.ts",
    "db:dump": "bash scripts/db-dump-local.sh",
    "db:push-neon": "node --env-file=.env --import tsx scripts/db-push-neon.ts",
    "db:sync-neon": "npm run db:dump && npm run db:push-neon",
    "beta:publish": "node --env-file=.env --import tsx scripts/beta-publish.ts",
    "import:egrkn": "node --env-file=.env --import tsx scripts/import-egrkn.ts",
    "enrich:mo": "node --env-file=.env --import tsx scripts/enrich-wikidata.ts",
    "enrich:all": "node --env-file=.env --import tsx scripts/enrich-all-sources.ts",
    "enrich:stats": "node --env-file=.env --import tsx scripts/enrich-coverage-stats.ts",
    "photos:audit": "node --env-file=.env --import tsx scripts/audit-photos.ts",
    "photos:test": "node --import tsx scripts/test-photo-match.ts",
    "pastvu:test": "node --import tsx scripts/test-pastvu-match.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
